# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/portfolio
# or MongoDB Atlas:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/portfolio

# Email (Nodemailer / Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password          # Gmail App Password (not account password)
NOTIFY_EMAIL=abhiyankgujjar00@gmail.com

# Groq
GROQ_API_KEY=gsk_...

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-portfolio.com

# Admin (optional – protects /analytics)
ADMIN_SECRET=change_me_strong_secret
